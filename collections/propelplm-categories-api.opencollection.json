{
  "opencollection": "1.0.0",
  "info": {
    "name": "Get Bom Assembly categories API",
    "version": "3.0"
  },
  "items": [
    {
      "info": {
        "name": "categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Categroies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/categories"
          },
          "docs": "Get All Categroies"
        },
        {
          "info": {
            "name": "Get Category Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/categories/:categoryId",
            "params": [
              {
                "name": "categoryId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Category Info"
        },
        {
          "info": {
            "name": "Get Category's Products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/categories/:categoryId/products",
            "params": [
              {
                "name": "categoryId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Category's Products"
        }
      ]
    }
  ],
  "bundled": true

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Get Bom Assembly channels API",
    "version": "3.0"
  },
  "items": [
    {
      "info": {
        "name": "channels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Channels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/channels"
          },
          "docs": "Get All Channels"
        },
        {
          "info": {
            "name": "Get Channel Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/channels/:channelId",
            "params": [
              {
                "name": "channelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Channel Info"
        },
        {
          "info": {
            "name": "Get Channel's Products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{endpoint}/services/apexrest/{namespace}/v2/channels/:channelId/products",
            "params": [
              {
                "name": "channelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Channel's Products"
        }
      ]
    }
  ],
  "bundled": true
}
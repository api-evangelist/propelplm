        {
          "id": "c04e0e73-65e1-48e1-ab3b-e90dd3f8dcf7",
          "name": "BOM",
          "request": {
            "name": "BOM",
            "description": {
              "content": "Query to return a list of assembly records which represent the full BOM for the given Item.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "item",
                ":itemNumber",
                "bom"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "level",
                  "value": "all",
                  "description": "Level of BOM to fetch. Defaults to All levels. Accepts 'all' or '1', '2', '3', etc."
                },
                {
                  "disabled": false,
                  "key": "delta",
                  "value": "false",
                  "description": "Returns the deltas in the BOM between the latest released revision and previous revision in addition to the BOM."
                },
                {
                  "disabled": false,
                  "key": "flatten",
                  "value": "false",
                  "description": "Returns a list of parts in the assembly without level. Will combine duplicate BOM rows that exist at different levels into a single BOM row."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "itemNumber",
                  "description": "(Required) Item Revision Id or Item Number of assembly to retrieve the BOM for. If Item Id or Item Number is provided, will default to latest released revision or latest revision if there is no released revision."
                },
                {
                  "description": "This is the Salesforce instance url. It is the URL when using Salesforce Classic, i.e. propel.my.salesforce.com",
                  "type": "any",
                  "value": "{{endpoint}}",
                  "key": "endpoint"
                },
                {
                  "description": "This value should default to PDLM for production environments. For dev environments, provide the namespace to your dev org.",
                  "type": "any",
                  "value": "{{namespace}}",
                  "key": "namespace"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
